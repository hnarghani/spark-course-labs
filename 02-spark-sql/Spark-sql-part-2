# 33. Convert Log to DataFrame

### Cell 66

python
log_pattern = r'^(\S+) (\S+) (\S+) \[([^\]]+)\] "(\S+) (\S+) (\S+)" (\d+) (\d+) "([^"]*)" "([^"]*)"'

### Cell 67

python
parsed = raw_logs.select(
    F.regexp_extract(F.col("value"), log_pattern, 1).alias("ip"),
    F.regexp_extract(F.col("value"), log_pattern, 2).alias("ident"),
    F.regexp_extract(F.col("value"), log_pattern, 3).alias("user_id"),
    F.regexp_extract(F.col("value"), log_pattern, 4).alias("timestamp"),
    F.regexp_extract(F.col("value"), log_pattern, 5).alias("method"),
    F.regexp_extract(F.col("value"), log_pattern, 6).alias("url"),
    F.regexp_extract(F.col("value"), log_pattern, 7).alias("protocol"),
    F.regexp_extract(F.col("value"), log_pattern, 8).cast("int").alias("status"),
    F.regexp_extract(F.col("value"), log_pattern, 9).cast("long").alias("bytes"),
    F.regexp_extract(F.col("value"), log_pattern, 10).alias("referer"),
    F.regexp_extract(F.col("value"), log_pattern, 11).alias("user_agent")
)

parsed.show(truncate=False)

